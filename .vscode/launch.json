{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QEMU + Clang (local :1234)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/qemu-debug/app",
      "cwd": "${workspaceFolder}/qemu-debug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "stopAtEntry": true,
      "externalConsole": false,
      "preLaunchTask": "qemu-gdb-server",
      "setupCommands": [
        {
          "description": "Pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "QEMU + Clang (remote host)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/qemu-debug/app",
      "cwd": "${workspaceFolder}/qemu-debug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb-multiarch",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "stopAtEntry": true,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Attach only (QEMU already running)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/qemu-debug/app",
      "cwd": "${workspaceFolder}/qemu-debug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "stopAtEntry": true,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
