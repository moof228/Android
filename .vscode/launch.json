{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QEMU + Clang + LLDB (local :1234)",
      "type": "lldb",
      "request": "custom",
      "preLaunchTask": "qemu-gdb-server",
      "targetCreateCommands": [
        "target create ${workspaceFolder}/qemu-debug/app"
      ],
      "processCreateCommands": [
        "gdb-remote 127.0.0.1:1234"
      ]
    },
    {
      "name": "QEMU + Clang + LLDB (remote / attach)",
      "type": "lldb",
      "request": "custom",
      "targetCreateCommands": [
        "target create ${workspaceFolder}/qemu-debug/app"
      ],
      "processCreateCommands": [
        "gdb-remote 127.0.0.1:1234"
      ]
    },
    {
      "name": "QEMU + Clang + GDB (local :1234)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/qemu-debug/app",
      "cwd": "${workspaceFolder}/qemu-debug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "stopAtEntry": true,
      "externalConsole": false,
      "preLaunchTask": "qemu-gdb-server",
      "setupCommands": [
        {
          "description": "Pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "QEMU + Clang + GDB (remote host)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/qemu-debug/app",
      "cwd": "${workspaceFolder}/qemu-debug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb-multiarch",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "stopAtEntry": true,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Attach GDB only (QEMU already running)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/qemu-debug/app",
      "cwd": "${workspaceFolder}/qemu-debug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "stopAtEntry": true,
      "externalConsole": false,
      "setupCommands": [
        {
          "description": "Pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
